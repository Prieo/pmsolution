<style>
:root{
  --navy:#0b1f3a; --navy2:#123055; --deep:#07152a;
  --ink:#0f172a; --mut:#5b6b7f; --line:#e3eaf2; --bg:#f6f9fc;
  --acc:#06b6d4; --acc2:#0891b2; --teal:#2dd4bf;
  --rad:16px; --shadow:0 10px 30px rgba(11,31,58,.08);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;color:var(--ink);background:#fff;line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:'Sora',sans-serif;line-height:1.2;color:var(--navy)}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.wrap{max-width:1140px;margin:0 auto;padding:0 22px}
section{padding:84px 0}
.eyebrow{display:inline-block;font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--acc2);margin-bottom:12px}
.sec-head{max-width:640px;margin-bottom:44px}
.sec-head h2{font-size:clamp(1.7rem,3.4vw,2.4rem);margin-bottom:12px}
.sec-head p{color:var(--mut);font-size:1.02rem}
.center{margin-left:auto;margin-right:auto;text-align:center}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:10px;font-weight:700;font-size:.95rem;cursor:pointer;border:none;transition:.2s;font-family:'Inter',sans-serif}
.btn-p{background:var(--acc);color:#04121f}
.btn-p:hover{background:#22d3ee;transform:translateY(-2px)}
.btn-g{background:transparent;color:#e8f6ff;border:1px solid rgba(255,255,255,.35)}
.btn-g:hover{border-color:#7dd3fc;color:#7dd3fc}
.btn-o{background:#fff;color:var(--navy);border:1.5px solid var(--navy)}
.btn-o:hover{background:var(--navy);color:#fff}
.btn-sm{padding:9px 18px;font-size:.85rem}

/* Header */
header{position:fixed;inset:0 0 auto 0;z-index:100;transition:.25s;background:transparent}
header.scrolled{background:rgba(7,21,42,.92);backdrop-filter:blur(12px);box-shadow:0 4px 24px rgba(0,0,0,.25)}
.nav{display:flex;align-items:center;justify-content:space-between;height:72px}
.logo{display:flex;align-items:center;gap:10px;color:#fff;font-family:'Sora',sans-serif;font-weight:800;font-size:1.25rem}
.logo small{display:block;font-size:.62rem;font-weight:500;letter-spacing:.12em;color:#7dd3fc;text-transform:uppercase}
.nav-links{display:flex;gap:26px;align-items:center}
.nav-links a{color:#cfe3f5;font-size:.9rem;font-weight:500;position:relative;padding:4px 0}
.nav-links a:hover,.nav-links a.active{color:#fff}
.nav-links a.active::after{content:'';position:absolute;left:0;right:0;bottom:-4px;height:2px;background:var(--acc);border-radius:2px}
.nav-cta{background:var(--acc);color:#04121f !important;padding:9px 18px;border-radius:9px;font-weight:700}
.nav-cta:hover{background:#22d3ee}
.nav-cta::after{display:none}
.burger{display:none;background:none;border:none;cursor:pointer;padding:6px}
.burger span{display:block;width:24px;height:2.5px;background:#fff;margin:5px 0;border-radius:2px;transition:.25s}
.burger.open span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}

/* Hero */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;background:radial-gradient(1000px 600px at 80% -10%,#16406e 0%,transparent 60%),radial-gradient(800px 500px at -10% 110%,#0e3a5c 0%,transparent 55%),linear-gradient(160deg,#07152a 0%,#0b1f3a 60%,#0e2a4d 100%);overflow:hidden;padding:140px 0 90px}
#netCanvas{position:absolute;inset:0;width:100%;height:100%;opacity:.55}
.hero-inner{position:relative;z-index:2;color:#fff}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(45,212,191,.1);border:1px solid rgba(45,212,191,.35);color:#5eead4;font-size:.8rem;font-weight:600;padding:7px 15px;border-radius:99px;margin-bottom:22px;letter-spacing:.03em}
.hero h1{color:#fff;font-size:clamp(2.3rem,5.6vw,4rem);letter-spacing:-.02em;margin-bottom:20px;max-width:820px}
.hero h1 em{font-style:normal;color:#38bdf8}
.hero p{color:#b8cde2;max-width:640px;font-size:1.08rem;margin-bottom:34px}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:40px}
.hero-chips{display:flex;gap:10px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);color:#d5e6f7;font-size:.82rem;font-weight:500;padding:8px 15px;border-radius:99px}
.chip svg{width:14px;height:14px;stroke:#5eead4}

/* Stats */
.stats{background:var(--deep);border-top:1px solid rgba(255,255,255,.06);padding:38px 0}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center}
.stat b{font-family:'Sora',sans-serif;font-size:2rem;color:#38bdf8;display:block}
.stat span{color:#8fa8c2;font-size:.85rem}

/* Services */
.svc-sec{background:var(--bg)}
.filters{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:30px}
.fbtn{padding:8px 17px;border-radius:99px;border:1px solid var(--line);background:#fff;color:var(--mut);font-weight:600;font-size:.84rem;cursor:pointer;transition:.2s;font-family:'Inter',sans-serif}
.fbtn:hover{border-color:var(--acc);color:var(--acc2)}
.fbtn.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.svc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:18px}
.svc{background:#fff;border:1px solid var(--line);border-radius:var(--rad);padding:24px;transition:.25s;display:flex;flex-direction:column;gap:10px}
.svc:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:#bcd9ea}
.svc svg{width:30px;height:30px;stroke:var(--acc2);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.svc h3{font-size:1rem}
.svc p{color:var(--mut);font-size:.86rem;flex:1}
.price{font-weight:700;color:var(--acc2);font-size:.92rem;font-family:'Sora',sans-serif}
.fineprint{margin-top:26px;color:var(--mut);font-size:.83rem;font-style:italic}

/* Packages */
.pkg-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.pkg{background:#fff;border:1.5px solid var(--line);border-radius:var(--rad);padding:28px 24px;position:relative;transition:.25s;display:flex;flex-direction:column}
.pkg:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.pkg.pop{border-color:var(--acc);background:linear-gradient(180deg,#f0fbfe,#fff)}
.pkg .tag{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--acc);color:#04121f;font-size:.7rem;font-weight:800;letter-spacing:.06em;padding:5px 14px;border-radius:99px;text-transform:uppercase;white-space:nowrap}
.pkg h3{font-size:1.15rem;margin-bottom:4px}
.pkg .size{color:var(--mut);font-size:.82rem;margin-bottom:14px}
.pkg .price{font-size:1.25rem;margin-bottom:18px}
.pkg ul{list-style:none;flex:1;margin-bottom:22px}
.pkg li{font-size:.86rem;color:#33445c;padding:5px 0 5px 24px;position:relative}
.pkg li::before{content:'✓';position:absolute;left:0;color:var(--acc2);font-weight:800}

/* AMC + on-demand */
.dark{background:linear-gradient(160deg,#0b1f3a,#0e2a4d);color:#dbe9f7}
.dark .sec-head h2{color:#fff}
.dark .sec-head p{color:#9db6cf}
.amc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:56px}
.amc{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:var(--rad);padding:30px 26px;transition:.25s;display:flex;flex-direction:column}
.amc:hover{background:rgba(255,255,255,.09);transform:translateY(-4px)}
.amc.pop{border-color:var(--teal);background:rgba(45,212,191,.08)}
.amc .tag{position:absolute;top:-13px;left:26px;background:var(--teal);color:#04121f;font-size:.7rem;font-weight:800;padding:5px 13px;border-radius:99px;letter-spacing:.05em;text-transform:uppercase}
.amc{position:relative}
.amc h3{color:#fff;font-size:1.2rem;margin-bottom:6px}
.amc .price{color:#5eead4;font-size:1.3rem;margin-bottom:16px;font-family:'Sora',sans-serif;font-weight:700}
.amc ul{list-style:none;flex:1}
.amc li{font-size:.88rem;color:#c3d6ea;padding:6px 0 6px 24px;position:relative}
.amc li::before{content:'✓';position:absolute;left:0;color:#5eead4;font-weight:800}
.ondemand{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);border-radius:var(--rad);overflow:hidden}
.ondemand h3{color:#fff;padding:20px 26px 6px;font-size:1.1rem}
.ondemand table{width:100%;border-collapse:collapse}
.ondemand th{color:#7dd3fc;text-align:left;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;padding:14px 26px;border-bottom:1px solid rgba(255,255,255,.12)}
.ondemand td{padding:14px 26px;border-bottom:1px solid rgba(255,255,255,.07);font-size:.92rem;color:#dbe9f7}
.ondemand td:last-child{color:#5eead4;font-weight:700;white-space:nowrap}
.ondemand tr:last-child td{border-bottom:none}

/* Offer banner */
.offer{background:linear-gradient(90deg,var(--acc) 0%,#0ea5e9 100%);border-radius:20px;padding:36px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;color:#04121f}
.offer h3{color:#04121f;font-size:1.35rem;margin-bottom:6px}
.offer p{font-weight:500;font-size:.95rem}
.offer .btn-p{background:#04121f;color:#fff}
.offer .btn-p:hover{background:#123055}

/* Why */
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.why{background:#fff;border:1px solid var(--line);border-radius:var(--rad);padding:28px;transition:.25s}
.why:hover{box-shadow:var(--shadow);transform:translateY(-4px)}
.why .ic{width:46px;height:46px;border-radius:12px;background:#e6f9fd;display:flex;align-items:center;justify-content:center;margin-bottom:16px}
.why .ic svg{width:22px;height:22px;stroke:var(--acc2);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.why h3{font-size:1.02rem;margin-bottom:8px}
.why p{color:var(--mut);font-size:.88rem}

/* Projects */
.proj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.proj{background:#fff;border:1px solid var(--line);border-radius:var(--rad);overflow:hidden;transition:.25s;display:flex;flex-direction:column}
.proj:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.proj .band{height:6px;background:linear-gradient(90deg,var(--acc),var(--teal))}
.proj .body{padding:26px;display:flex;flex-direction:column;flex:1}
.proj .cat{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin-bottom:8px}
.proj h3{font-size:1.1rem;margin-bottom:10px}
.proj p{color:var(--mut);font-size:.88rem;flex:1}
.metrics{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.metric{background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:7px 12px;font-size:.78rem;font-weight:700;color:var(--navy)}

/* About */
.about{background:var(--bg)}
.about-grid{display:grid;grid-template-columns:340px 1fr;gap:56px;align-items:start}
.photo{position:relative;border-radius:20px;overflow:hidden;box-shadow:var(--shadow);aspect-ratio:3/3.6;background:linear-gradient(160deg,var(--navy),var(--navy2))}
.photo img{width:100%;height:100%;object-fit:cover}
.avatar-fb{display:none;width:100%;height:100%;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:4.5rem;color:#7dd3fc;font-weight:800}
.certs{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}
.cert{background:#fff;border:1.5px solid #bcd9ea;color:var(--navy2);font-size:.75rem;font-weight:800;padding:6px 13px;border-radius:99px;letter-spacing:.04em}
.skills{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.skill{background:#eef4fa;border:1px solid var(--line);color:#3a4d66;font-size:.78rem;font-weight:600;padding:5px 12px;border-radius:8px}
.about-txt h2{font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:8px}
.about-txt .role{color:var(--acc2);font-weight:700;font-size:.95rem;margin-bottom:18px}
.about-txt p{color:#33445c;margin-bottom:14px;font-size:.97rem}
.about-txt .edu{margin-top:18px;padding:16px 18px;background:#fff;border:1px solid var(--line);border-radius:12px;font-size:.87rem;color:var(--mut)}
.about-txt .edu b{color:var(--navy)}

/* FAQ */
.faq{max-width:760px;margin:0 auto}
.faq details{background:#fff;border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden}
.faq summary{padding:18px 22px;font-weight:600;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;color:var(--navy)}
.faq summary::after{content:'+';font-size:1.4rem;color:var(--acc2);font-weight:400;transition:.2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq .a{padding:0 22px 18px;color:var(--mut);font-size:.9rem}

/* Contact */
.contact-grid{display:grid;grid-template-columns:1fr 1.15fr;gap:44px}
.c-card{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 20px;margin-bottom:14px;transition:.2s}
.c-card:hover{border-color:var(--acc);box-shadow:var(--shadow)}
.c-card .ic{width:42px;height:42px;flex:none;border-radius:11px;background:#e6f9fd;display:flex;align-items:center;justify-content:center}
.c-card .ic svg{width:20px;height:20px;stroke:var(--acc2);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.c-card b{display:block;font-size:.93rem;color:var(--navy)}
.c-card span{font-size:.87rem;color:var(--mut)}
.form{background:#fff;border:1px solid var(--line);border-radius:20px;padding:34px;box-shadow:var(--shadow)}
.form h3{font-size:1.25rem;margin-bottom:4px}
.form>p{color:var(--mut);font-size:.88rem;margin-bottom:22px}
.field{margin-bottom:16px}
.field label{display:block;font-size:.8rem;font-weight:700;color:var(--navy);margin-bottom:6px}
.field input,.field select,.field textarea{width:100%;padding:12px 14px;border:1.5px solid var(--line);border-radius:10px;font-family:'Inter',sans-serif;font-size:.92rem;color:var(--ink);background:#fbfdfe;transition:.2s}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--acc);background:#fff}
.form-btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:6px}
.btn-wa{background:#25d366;color:#04120a}
.btn-wa:hover{background:#3ee07d;transform:translateY(-2px)}

/* Footer */
footer{background:var(--deep);color:#8fa8c2;padding:56px 0 28px}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;margin-bottom:36px}
footer h4{color:#fff;font-size:.95rem;margin-bottom:16px}
footer a:hover{color:#7dd3fc}
.foot-links{display:flex;flex-direction:column;gap:9px;font-size:.88rem}
.foot-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:22px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.8rem}

/* WhatsApp float */
.wa-float{position:fixed;right:22px;bottom:22px;z-index:90;width:56px;height:56px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(37,211,102,.45);transition:.2s}
.wa-float:hover{transform:scale(1.08)}
.wa-float svg{width:28px;height:28px;fill:#fff}

/* Reveal */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
.reveal.in{opacity:1;transform:none}

/* Back to top */
.top{position:fixed;left:22px;bottom:22px;z-index:90;width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:#fff;color:var(--navy);cursor:pointer;font-size:1.1rem;opacity:0;pointer-events:none;transition:.25s;box-shadow:var(--shadow)}
.top.show{opacity:1;pointer-events:auto}

@media(max-width:960px){
  .nav-links{position:fixed;top:72px;left:0;right:0;background:rgba(7,21,42,.98);backdrop-filter:blur(14px);flex-direction:column;padding:26px 22px;gap:18px;transform:translateY(-130%);transition:.3s;border-bottom:1px solid rgba(255,255,255,.08)}
  .nav-links.open{transform:none}
  .burger{display:block}
  .stats-grid{grid-template-columns:repeat(2,1fr)}
  .pkg-grid{grid-template-columns:repeat(2,1fr)}
  .amc-grid,.why-grid,.proj-grid{grid-template-columns:1fr 1fr}
  .about-grid{grid-template-columns:1fr;gap:34px}
  .photo{max-width:340px}
  .contact-grid{grid-template-columns:1fr}
  .foot-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  section{padding:60px 0}
  .pkg-grid,.amc-grid,.why-grid,.proj-grid{grid-template-columns:1fr}
  .foot-grid{grid-template-columns:1fr}
  .offer{padding:28px 24px}
  .ondemand th,.ondemand td{padding:12px 16px}
}
@media(prefers-reduced-motion:reduce){
  .reveal{opacity:1;transform:none;transition:none}
  html{scroll-behavior:auto}
}
</style>
</head>
