    <div class="hero-chips">
      <span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>Free site survey for new deployments</span>
      <span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>30-day support warranty on configuration</span>
      <span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>Itemized, transparent pricing</span>
    </div>
  </div>
</section>

<!-- ================= STATS ================= -->
<div class="stats">
  <div class="wrap stats-grid">
    <div class="stat"><b><span data-count="60">0</span>+</b><span>Switches deployed — one campus project</span></div>
    <div class="stat"><b><span data-count="160">0</span>+</b><span>Fiber fusion splices delivered</span></div>
    <div class="stat"><b><span data-count="5">0</span></b><span>Professional certifications</span></div>
    <div class="stat"><b><span data-count="30">0</span>-day</b><span>Support warranty on all config work</span></div>
  </div>
</div>

<!-- ================= SERVICES ================= -->
<section class="svc-sec" id="services">
  <div class="wrap">
