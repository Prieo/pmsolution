/* ---------- Hero network animation ---------- */
(function(){
  const c=document.getElementById('netCanvas');if(!c)return;
  const x=c.getContext('2d');let w,h,P=[];const mouse={x:-999,y:-999};
  const rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const N=innerWidth<640?35:70;
  function rs(){w=c.width=c.clientWidth;h=c.height=c.clientHeight;}
  function mk(){P=[];for(let i=0;i<N;i++)P.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.4,vy:(Math.random()-.5)*.4,r:Math.random()*1.4+1});}
  rs();mk();
  addEventListener('resize',()=>{rs();mk();});
  c.parentElement.addEventListener('mousemove',e=>{const b=c.getBoundingClientRect();mouse.x=e.clientX-b.left;mouse.y=e.clientY-b.top;});
  c.parentElement.addEventListener('mouseleave',()=>{mouse.x=-999;});
  function tick(){
    x.clearRect(0,0,w,h);
    for(const p of P){p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;}
    for(let i=0;i<P.length;i++){const a=P[i];
      for(let j=i+1;j<P.length;j++){const b=P[j],d=Math.hypot(a.x-b.x,a.y-b.y);
        if(d<120){x.strokeStyle=`rgba(56,189,248,${(1-d/120)*.22})`;x.lineWidth=1;x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke();}}
      const md=Math.hypot(a.x-mouse.x,a.y-mouse.y);
      if(md<160){x.strokeStyle=`rgba(94,234,212,${(1-md/160)*.45})`;x.beginPath();x.moveTo(a.x,a.y);x.lineTo(mouse.x,mouse.y);x.stroke();}
    }
    for(const p of P){x.fillStyle='rgba(125,211,252,.85)';x.beginPath();x.arc(p.x,p.y,p.r,0,7);x.fill();}
    if(!rm)requestAnimationFrame(tick);
  }
  tick();
})();
</script>
